# Local-demo defaults only. These are not production credentials.
EVE_RAG_APP_NAME=EVE Relation RAG
EVE_RAG_APP_VERSION=V0
EVE_RAG_ENVIRONMENT=development
EVE_RAG_DATABASE_URL=postgresql+psycopg://eve:eve_dev_password@localhost:5432/eve_relation_rag
# Development-only cursor secret. Generate at least 32 random bytes outside this local demo.
EVE_RAG_CURSOR_HMAC_SECRET=local-demo-only-cursor-secret-0123456789abcdef0123456789abcdef
EVE_RAG_LLM_PROVIDER=disabled

# Streamlit calls this server-side. It is never editable in the browser UI.
EVE_RAG_DEMO_API_BASE_URL=http://127.0.0.1:8000

POSTGRES_DB=eve_relation_rag
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve_dev_password
POSTGRES_PORT=5432
API_PORT=8000
DEMO_PORT=8501

# Version-constrained quick-start inputs. Pin approved digests for a release.
EVE_RAG_IMAGE=eve-relation-rag:v0-local
PYTHON_IMAGE=python:3.12.13-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.5
POSTGRES_IMAGE=pgvector/pgvector:pg16
