# Development-only defaults. Replace them outside local development.
EVE_RAG_APP_NAME=EVE Relation RAG
EVE_RAG_APP_VERSION=V0
EVE_RAG_ENVIRONMENT=development
EVE_RAG_DATABASE_URL=postgresql+psycopg://eve:eve_dev_password@localhost:5432/eve_relation_rag
# Required for successful structured fact queries; generate at least 32 random bytes.
EVE_RAG_CURSOR_HMAC_SECRET=REPLACE_ME

POSTGRES_DB=eve_relation_rag
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve_dev_password
POSTGRES_PORT=5432
